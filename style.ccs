body { 
  background: #0a0a0a; 
  color: white; 
  font-family: 'Space Grotesk', sans-serif; /* Un toque más moderno */
  margin: 0; 
  padding: 0; 
  overflow-x: hidden; /* Evita scroll lateral molesto */
  overflow-y: auto; 
}

.rubens-main-container {
  display: flex;
  flex-direction: row; /* Alineación horizontal por defecto */
  flex-wrap: wrap; 
  justify-content: center;
  align-items: flex-start; /* Alinea arriba para que el texto y tubo coincidan */
  gap: 50px;
  padding: 80px 5%; /* Más aire arriba y abajo */
  min-height: 100vh;
}

.rubens-text-column {
  flex: 1 1 400px; /* Crece y encoge, pero intenta mantener 400px */
  max-width: 500px; 
  line-height: 1.8;
  font-size: 1.1rem;
}

.rubens-visual-column {
  flex: 1 1 450px;
  max-width: 600px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30px;
}

#playButton {
  background: #ff4500;
  color: white;
  border: none;
  padding: 15px 30px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: bold;
  font-size: 1rem;
  transition: all 0.3s ease;
  box-shadow: 0 4px 15px rgba(255, 69, 0, 0.3);
}

#playButton:hover { 
  background: #e63e00; 
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(255, 69, 0, 0.5);
}

.graphics-area {
  display: flex;
  align-items: flex-end; /* Importante: Todo toca el "suelo" */
  justify-content: center;
  gap: 20px;
  width: 100%;
}

/* CORRECCIÓN CLAVE: Esto encoge los cuadros del parlante y theremin */
.devices {
  flex: 0 0 70px; /* Tamaño fijo de 70px, no se mueven de ahí */
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.icon-svg { 
  width: 100%; 
  height: auto; 
  opacity: 0.8; /* Les da un toque más elegante */
}

/* EL TUBO: Ahora es el que manda */
.rubens-svg { 
  flex: 1; 
  height: auto; 
  max-width: 450px; /* Más grande para que destaque */
  filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.05));
}

.flame {
  transform: scaleY(0.3); /* Base para el JS */
  transform-origin: bottom center;
  mix-blend-mode: screen;
  filter: url(#flame-blur);
  transition: transform 0.1s ease-out;
}

/* Colores con brillo reforzado */
.purple { fill: #b000ff; filter: drop-shadow(0 0 8px #b000ff); }
.blue   { fill: #00bbff; filter: drop-shadow(0 0 8px #00bbff); }
.green  { fill: #00ff88; filter: drop-shadow(0 0 8px #00ff88); }
.yellow { fill: #ffb400; filter: drop-shadow(0 0 8px #ffb400); }
