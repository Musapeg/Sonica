body { background: #0a0a0a; color: white; font-family: sans-serif; margin: 0; padding: 0; overflow-y: auto; }

.rubens-main-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 40px;
  padding: 50px 20px;
  min-height: 400px;
}

.rubens-text-column {
  flex: 1;
  max-width: 400px;
  line-height: 1.6;
}

.rubens-visual-column {
  flex: 1;
  max-width: 500px; /* Un poco más de aire para el experimento */
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}

#playButton {
  background: #ff4500;
  color: white;
  border: none;
  padding: 12px 24px;
  border-radius: 5px;
  cursor: pointer;
  font-weight: bold;
  transition: 0.2s;
}

#playButton:hover { background: #e63e00; }

.graphics-area {
  display: flex;
  align-items: flex-end;
  gap: 15px;
  width: 100%;
}

.devices {
  width: 60px;
  flex: 0 0 60px; /* Bloqueamos el tamaño para que no crezcan */
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.icon-svg { width: 100%; height: auto; }

.rubens-svg { 
  flex: 2; /* El tubo ahora manda en el espacio */
  height: auto; 
  max-width: 350px; 
}

.flame {
  transform: scaleY(0.3); /* Tamaño base fundamental */
  transform-origin: bottom center;
  mix-blend-mode: screen;
  filter: url(#flame-blur);
  transition: transform 0.1s ease-out;
}

/* Tus colores originales intactos */
.purple { fill: url(#grad-purple); filter: drop-shadow(0 0 5px #b000ff); }
.blue   { fill: url(#grad-blue);   filter: drop-shadow(0 0 5px #00bbff); }
.green  { fill: url(#grad-green);  filter: drop-shadow(0 0 5px #00ff88); }
.yellow { fill: url(#grad-yellow); filter: drop-shadow(0 0 5px #ffb400); }
