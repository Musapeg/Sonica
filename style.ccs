body { background: #0a0a0a; color: white; font-family: sans-serif; margin: 0; padding: 0; overflow-y: auto; overflow-x: hidden; }

.rubens-main-container {
  display: flex;
  gap: 2rem;
  align-items: center;
}

.rubens-visual-column {
  width: 100%;
}

.graphics-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* dispositivos más pequeños */
.devices {
  display: flex;
  gap: 10px;
  margin-bottom: 10px;
}

.icon-svg {
  width: 60px;
  height: 60px;
  opacity: 0.7;
}

/* tubo MÁS GRANDE */
.rubens-svg {
  width: 100%;
  max-width: 600px;
}

/* ARREGLO DE LAS LLAMAS (Movimiento y tamaño base) */
.flame {
  transform: scaleY(0.3); 
  transform-origin: bottom center;
  mix-blend-mode: screen;
  transition: transform 0.05s ease-out; /* Más reactivo a la música */
}

.flame {
  transform-origin: bottom;
  transition: transform 0.1s linear;
}

.flame {
  filter: drop-shadow(0 0 6px currentColor);
}
